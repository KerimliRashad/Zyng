BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# eSIM Access API
ESIM_API_KEY=your_esim_access_api_key
ESIM_API_URL=https://api.esimaccess.com/api/v1/open

# YooKassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# Webhook (для YooKassa)
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/yookassa-webhook
WEB_PORT=8080

# Markup (наценка в процентах, например 30 = +30%)
MARKUP_PERCENT=30
